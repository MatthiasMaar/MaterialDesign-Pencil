{
  "name": "material-design-pencil",
  "version": "7.4.47-1",
  "description": "Material Design Icons for Pencil",
  "license": "MIT",
  "keywords": [
    "Pencil",
    "Material Design Icons"
  ],
  "private": true,
  "author": {
    "name": "Matthias Maar",
    "email": "matthias@computergott.de",
    "url": "https://www.computergott.de"
  },
  "homepage": "https://github.com/MatthiasMaar/MaterialDesign-Pencil",
  "repository": {
    "url": "https://github.com/MatthiasMaar/MaterialDesign-Pencil.git"
  },
  "bugs": {
    "email": "matthias@computergott.de",
    "url": "https://github.com/MatthiasMaar/MaterialDesign-Pencil/issues"
  },
  "main": "build.ts",
  "scripts": {
    "up": "bunx taze -I major",
    "build": "rimraf dist && rimraf MaterialDesign-Pencil-*.zip && bun build.ts",
    "tag": "git tag ${npm_package_version} && git push origin ${npm_package_version}"
  },
  "devDependencies": {
    "@mdi/svg": "7.4.47",
    "@types/archiver": "~8.0.0",
    "@types/bun": "~1.4.4",
    "archiver": "~8.0.0",
    "rimraf": "~6.1.3",
    "sharp": "~0.35.5",
    "svgson": "~5.3.1"
  },
  "prettier": {
    "useTabs": false,
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "htmlWhitespaceSensitivity": "css"
  }
}
